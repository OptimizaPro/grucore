# ─── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-this-to-a-random-50-char-string-in-production
DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://grucore:grucore@postgres:5432/grucore

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=change-this-to-a-random-32-char-string-in-production
NEXTAUTH_URL=http://localhost:3000

# ─── Frontend → Backend ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Django settings module ───────────────────────────────────────────────────
# development | production
DJANGO_SETTINGS_MODULE=grucore.settings.development

# ─── CORS (producción) ────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend
CORS_ALLOWED_ORIGINS=https://grucore.com,https://app.grucore.com

# ─── Supabase Storage (archivos, planos, fotos de obra) ───────────────────────
# Activar en producción: USE_S3=True
# Las variables S3 son compatibles con cualquier backend S3 (Supabase, R2, AWS)
USE_S3=False
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_BUCKET=grucore-media
SUPABASE_ACCESS_KEY_ID=
SUPABASE_SECRET_ACCESS_KEY=
# Region del proyecto Supabase (ej: ap-southeast-1)
SUPABASE_S3_REGION=ap-southeast-1

# ─── Email transaccional (Brevo SMTP) ─────────────────────────────────────────
# EMAIL_HOST y EMAIL_PORT ya tienen defaults en base.py (smtp-relay.brevo.com:587)
# EMAIL_HOST_USER  → tu email registrado en Brevo (ej: noreply@grucore.com)
# EMAIL_HOST_PASSWORD → SMTP API Key de Brevo (Transactional → SMTP & API → API Keys)
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@grucore.com

# ─── Tipo de cambio GTQ/USD ───────────────────────────────────────────────────
# Opcional: API key para actualización automática del tipo de cambio
EXCHANGE_RATE_API_KEY=
