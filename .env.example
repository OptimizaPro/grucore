# ─── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-this-to-a-random-50-char-string-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://grucore:grucore@postgres:5432/grucore

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=change-this-to-a-random-32-char-string-in-production
NEXTAUTH_URL=http://localhost:3000

# ─── Frontend → Backend ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Supabase Storage (archivos, planos, fotos de obra) ───────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ─── Email transaccional (Brevo) ──────────────────────────────────────────────
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=noreply@grucore.com

# ─── Tipo de cambio GTQ/USD ───────────────────────────────────────────────────
# Opcional: API key para actualización automática del tipo de cambio
EXCHANGE_RATE_API_KEY=

# ─── CORS (producción) ────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
